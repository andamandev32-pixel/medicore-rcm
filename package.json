{
  "name": "medicore-rcm",
  "version": "1.0.0",
  "description": "MediCore RCM — Express + MySQL + Design System (ยกโครงจาก medicore-starter)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seed-users.js && node src/database/seed-demo.js",
    "seed:users": "node src/database/seed-users.js",
    "seed:demo": "node src/database/seed-demo.js",
    "seed:reference": "node src/database/seed-reference.js",
    "seed:rules": "node src/database/seed-rules.js",
    "seed:tmt": "node src/database/load-tmt.js",
    "seed:ipd": "node src/database/seed-ipd-demo.js",
    "seed:finance": "node src/database/seed-finance.js",
    "load:icd": "node src/database/load-icd.js",
    "check:policy": "node scripts/check-policy.js",
    "check:rules": "node scripts/check-rules.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
