# ─── MediCore Starter — Environment Variables ───────────────────────────
# คัดลอกไฟล์นี้เป็น .env สำหรับรันในเครื่อง (local dev)
# บน Render: ตั้งค่าเหล่านี้ในเมนู Environment ของ Web Service (อย่า commit .env จริง)

# ── Database (MySQL) ──
# ใช้ server เดียวกับโปรเจคอื่นได้ แต่ DB_NAME ต้องเป็นของโปรเจคนี้เท่านั้น
# npm run migrate จะ CREATE DATABASE IF NOT EXISTS ให้เอง
DB_HOST=141.98.17.115
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=medicore_rcm

# ── Server ──
# บน Render ไม่ต้องตั้ง PORT — แพลตฟอร์มจ่ายให้เองผ่าน env
PORT=3000
NODE_ENV=development

# ── Auth ──
# ถ้า NODE_ENV=production แต่ไม่ตั้ง JWT_SECRET → server ปฏิเสธการ start (src/middleware/auth.js)
JWT_SECRET=change_me_use_a_long_random_string
JWT_EXPIRES=8h

# deny = บังคับสิทธิ์จริง (ค่าเริ่มต้น)
# log  = บันทึกว่าจะบล็อกอะไรแต่ปล่อยผ่าน — ใช้ตอน rollout เพื่อดูว่ามี caller ไหนตกหล่น
AUTH_ENFORCE=deny
